<?xml version="1.0" encoding="utf-8"?>
<!--
  Catalogue de ressources textuelles PARTAGÉ (Compose Multiplatform Resources).
  Source unique des libellés de l'application pour Android et iOS : la classe générée
  com.example.shared.resources.Res expose chaque entrée (Res.string.xxx, Res.array.xxx).

  Différences avec res/values/strings.xml Android :
  - seuls les arguments positionnels (%1$s, %1$d) sont interprétés : %s / %d ont été numérotés ;
  - pas d'échappement aapt : l'apostrophe s'écrit directement, et "%%" est évité (utiliser "%" seul).
-->
